  com.superkele.translation.boot.auto.EasyTranslationBaseBean,\
  com.superkele.translation.boot.auto.EasyTranslationInitConfig, \
  com.superkele.translation.boot.auto.EasyTranslationJacksonSerializeAutoConfig,\
  com.superkele.translation.boot.auto.EasyTranslationInject,\
  com.superkele.translation.boot.invoker.SpringInvokeBeanFactory,\
  com.superkele.translation.boot.resolver.SpringParamHandlerResolver,\
  com.superkele.translation.boot.resolver.SpringResultHandlerResolver